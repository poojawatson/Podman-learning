<configuration>

    <appender name="FILE"
              class="ch.qos.logback.core.FileAppender">

        logs/container-app.log

        <encoder>
            <pattern>%d %-5level %logger - %msg%n</pattern>
        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

</configuration>